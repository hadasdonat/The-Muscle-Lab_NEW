DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=the_muscle_lab
PORT=3000
JWT_SECRET=replace_with_a_random_secret

# Optional in development (defaults to local browser origins); required in production.
CORS_ORIGINS=

# Number of reverse-proxy hops in front of the API (hosting platforms). Leave blank locally.
TRUST_PROXY=

# Hosted databases: set DB_SSL=true. Add DB_SSL_CA only if the provider's CA isn't publicly trusted.
DB_SSL=
DB_SSL_CA=

# Gym time zone. Class times are local, so set this on servers that run in UTC.
TZ=Asia/Jerusalem

# AI Coach. Leave AI_API_KEY empty to use the built-in rule-based suggestions.
# AI_PROVIDER: gemini (default) | openai (any OpenAI-compatible API, set AI_BASE_URL) | anthropic
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=10000
